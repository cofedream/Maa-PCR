    "all_of": [
      "ReturnHomeControl",
      "ObserveMain"
    ],
    "action": "Click",
    "target": true,
    "max_hit": 1,
    "post_delay": 600,
    "next": [
      "ReturnHomeGate"
    ]
  },
  "ReturnHomeGate": {
    "timeout": 30000,
    "rate_limit": 250,
    "post_delay": 1000,
