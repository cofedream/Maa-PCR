<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MFAAvalonia.Pcr.PcrCaptchaOverlay"
             IsVisible="False" IsHitTestVisible="True">

    <Grid x:Name="OverlayRoot">
        <!-- Input-blocking backdrop: the task continues in the background but the
             main window stays modal until the human verification resolves. -->
        <Border x:Name="Mask" Background="#66000000" />

        <Border x:Name="Card"
                Width="560" Height="640"
                Background="{DynamicResource SukiCardBackground}"
                BorderBrush="{DynamicResource SukiBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                BoxShadow="0 10 40 0 #33000000"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="18,16,18,14">
                <StackPanel Spacing="3">
                    <TextBlock Text="人工安全验证" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SukiText}" />
                    <TextBlock Text="请在下方完成官方极验验证；登录账号和密码不会传入此页面。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource SukiLowText}" />
                </StackPanel>

                <Border x:Name="WebHost" Grid.Row="1" MinHeight="260"
                        Background="Transparent" CornerRadius="8" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               TextWrapping="Wrap" Foreground="{DynamicResource SukiLowText}" />
                    <Button x:Name="BrowserButton" Grid.Column="1" Content="在浏览器中打开"
                            Classes="Basic" Click="OpenInBrowser"
                            AutomationProperties.Name="在浏览器中打开验证页面" />
                    <Button x:Name="CancelButton" Grid.Column="2" Content="取消本次验证"
                            Classes="Basic" Click="CancelVerification"
                            AutomationProperties.Name="取消本次人工验证" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
